# Crea credenziali OAuth 2.0 in un progetto Google Cloud tuo.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8788/oauth2callback

# Genera questa chiave con: npm run generate-key
# Non riutilizzare la chiave OAuth e non committarla.
TOKEN_ENCRYPTION_KEY=replace-with-a-generated-32-byte-base64-key

# Configurazione locale: il server resta raggiungibile solo da questo computer.
MCP_HOST=127.0.0.1
MCP_PORT=8787
TOKEN_STORE_PATH=.data/google-tokens.enc

# Origini browser autorizzate per MCP Inspector e ChatGPT.
MCP_ALLOWED_ORIGINS=http://localhost:6274,http://127.0.0.1:6274,https://chatgpt.com,https://chat.openai.com
